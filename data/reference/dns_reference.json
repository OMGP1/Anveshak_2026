{
 "version": "1.0.0",
 "origin": "written by hand from well known public suffixes and cdn wildcard zones. no external corpus, no network lookup. it is deliberately short and is meant to be extended per deployment",
 "public_suffixes": [
  "co.in", "net.in", "org.in", "gov.in", "ac.in", "res.in", "edu.in", "nic.in",
  "co.uk", "org.uk", "gov.uk", "ac.uk", "me.uk", "ltd.uk", "plc.uk",
  "com.au", "net.au", "org.au", "edu.au", "gov.au",
  "co.jp", "or.jp", "ne.jp", "ac.jp", "go.jp",
  "com.br", "com.cn", "net.cn", "org.cn", "gov.cn",
  "co.za", "co.nz", "com.sg", "com.my", "com.hk", "com.tw", "com.mx", "com.ar",
  "co.kr", "or.kr", "com.tr", "com.ua", "com.pl", "com.es", "com.pt", "com.ru"
 ],
 "wildcard_domains": [
  {"domain": "akamaiedge.net", "reason": "akamai edge mapping, one label per edge node"},
  {"domain": "akamai.net", "reason": "akamai content delivery"},
  {"domain": "akadns.net", "reason": "akamai global traffic management"},
  {"domain": "edgekey.net", "reason": "akamai secure edge"},
  {"domain": "edgesuite.net", "reason": "akamai edge"},
  {"domain": "cloudfront.net", "reason": "aws cdn, one label per distribution"},
  {"domain": "amazonaws.com", "reason": "aws regional service endpoints and bucket names"},
  {"domain": "azureedge.net", "reason": "azure cdn"},
  {"domain": "windows.net", "reason": "azure storage and service endpoints"},
  {"domain": "cloudapp.azure.com", "reason": "azure hosted service names"},
  {"domain": "googleusercontent.com", "reason": "google user content, hash labels by design"},
  {"domain": "gvt1.com", "reason": "google update delivery"},
  {"domain": "1e100.net", "reason": "google infrastructure reverse names"},
  {"domain": "fastly.net", "reason": "fastly cdn"},
  {"domain": "fbcdn.net", "reason": "meta cdn"},
  {"domain": "cdn.cloudflare.net", "reason": "cloudflare cdn"},
  {"domain": "cloudflare.com", "reason": "cloudflare service endpoints"},
  {"domain": "trafficmanager.net", "reason": "azure traffic manager"},
  {"domain": "elasticbeanstalk.com", "reason": "aws hosted application names"},
  {"domain": "herokuapp.com", "reason": "paas hosted application names"},
  {"domain": "s3.amazonaws.com", "reason": "aws bucket names as labels"},
  {"domain": "dropboxusercontent.com", "reason": "user content hash labels"},
  {"domain": "sharepoint.com", "reason": "tenant names as labels"},
  {"domain": "office365.com", "reason": "tenant and service labels"},
  {"domain": "in-addr.arpa", "reason": "reverse dns, one label per address"},
  {"domain": "ip6.arpa", "reason": "reverse dns for ipv6"},
  {"domain": "spamhaus.org", "reason": "dnsbl, encodes the queried address in the label"},
  {"domain": "sophosxl.net", "reason": "endpoint reputation lookups encode a hash in the label"},
  {"domain": "mcafee.com", "reason": "endpoint reputation lookups encode a hash in the label"},
  {"domain": "avts.mcafee.com", "reason": "endpoint reputation lookups"},
  {"domain": "sophosupd.com", "reason": "endpoint update distribution"},
  {"domain": "ntp.org", "reason": "pool rotation produces many labels"}
 ],
 "suppression_policy": "a match suppresses the tunnelling rule only. it never suppresses the per-name dga score, and every suppression is counted and reported in the coverage endpoint rather than dropped silently"
}
